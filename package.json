{
	"name": "@kattebak/graphql-sdk-emitter",
	"version": "0.0.0",
	"description": "Generate a typed TypeScript SDK from a GraphQL SDL with pluggable auth (SigV4, Cognito bearer, API key)",
	"keywords": [
		"graphql",
		"sdk",
		"codegen",
		"typescript",
		"appsync",
		"sigv4",
		"cognito"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/kattebak/graphql-sdk-emitter.git"
	},
	"bugs": {
		"url": "https://github.com/kattebak/graphql-sdk-emitter/issues"
	},
	"homepage": "https://github.com/kattebak/graphql-sdk-emitter#readme",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"graphql-sdk-emitter": "bin/graphql-sdk-emitter.js"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"bin",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"default": "./dist/runtime/index.js"
		},
		"./auth": {
			"types": "./dist/auth/index.d.ts",
			"default": "./dist/auth/index.js"
		}
	},
	"scripts": {
		"fix": "biome check --write",
		"lint": "biome check",
		"build": "tsc -p tsconfig.build.json",
		"watch": "tsc -p tsconfig.build.json --watch",
		"test": "npm run build && npm run lint && npm run test:unit",
		"test:unit": "node --test --import=tsx 'src/**/*.test.ts'",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@graphql-codegen/cli": "^5.0.3",
		"@graphql-codegen/typescript": "^4.1.2",
		"@graphql-codegen/typescript-graphql-request": "^6.2.0",
		"@graphql-codegen/typescript-operations": "^4.4.0",
		"aws4fetch": "^1.0.20",
		"graphql": "^16.9.0",
		"graphql-request": "^7.1.2"
	},
	"peerDependencies": {
		"graphql": "^16.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.7",
		"@types/node": "^22.18.11",
		"semantic-release": "^24.2.0",
		"tsx": "^4.20.5",
		"typescript": "^5.9.3"
	}
}
