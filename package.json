{
	"name": "@kattebak/graphql-sdk-emitter",
	"version": "0.0.0",
	"description": "Generate a typed TypeScript SDK from a GraphQL SDL with pluggable auth (SigV4, Cognito bearer, API key)",
	"type": "module",
	"main": "dist/index.js",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"fix": "npx @biomejs/biome check --write",
		"lint": "npx @biomejs/biome check",
		"build": "tsc",
		"watch": "tsc --watch",
		"test": "npm run build && npm run lint && npm run test:unit",
		"test:unit": "node --test --import=tsx src/**/*.test.ts",
		"prepublishOnly": "tsc"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.7",
		"@types/node": "^22.18.11",
		"tsx": "^4.20.5",
		"typescript": "^5.9.3"
	}
}
